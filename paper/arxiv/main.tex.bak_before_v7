\section{Architecture}
\label{sec:arch}

Berna R5 is organized in six layers, from sensors to registry.

\begin{verbatim}
Input (text, vision, audio)
     |
     v
[Sensors]           raw signal encoding
     |
     v
[Spinal Cord]       fast rule-based routing
     |
     v
[Plexus]            dynamic graph of cells
     |
     v
[Knowledge Cells]   born, split, die, interconnect
     |
     v
[DNA Kernel]        100 chromosomes, regulatory
     |
     v
[Registry]          SQL, UUIDs, lineage, routing
\end{verbatim}

\subsection{Sensors}
The sensor layer converts raw input into token sequences.
Vocabulary is 200k, partitioned: text (0--63,999), vision
(64,000--163,999), audio (164,000--199,999).

\subsection{Spinal Cord}
Rule-based fast router. It does not use learned weights.
Rules are stored as JSON and loaded at boot. Deterministic
and auditable.

\subsection{Plexus}
Dynamic graph $P = (V, E, W)$ where $V$ = nodes, $E$ = edges,
$W: E \to \mathbb{R}_+$ = edge weights. Edges strengthen
through co-activation:
\begin{equation}
W_{uv}(t+1) = W_{uv}(t) + \eta_e \cdot (A_{uv}(t) - \lambda \cdot W_{uv}(t))
\end{equation}
where $A_{uv}(t)$ is the correlation of activations.

\subsection{Knowledge Cells}
Each cell has: UUID, domain, state (active/dormant/frozen/dead),
6D vector $K$, adaptive weights $\omega$, saturation score $S$.

\subsection{DNA Kernel}
100 chromosomes in 10 groups: language, math, code, science,
sensory, reasoning, memory, coordination, adaptation, growth.
Each chromosome has 4 genes: activation, sensitivity,
persistence, plasticity.

\subsection{Federation}
Base model + $N$ specialists. Communication via SQL registry.
Specialists have UUID, parent ID, domain key
(SHA256 of domain$|$version$|$param\_hash), and signature.

\subsection{Zero-Error Invariant}
Every layer enforces: any violation triggers FAIL\_CLOSED.
There are no silent failures.

\section{Theory}
\label{sec:theory}

We present results in three categories: two mathematical
theorems (full proofs), two design invariants (enforced by
system design), and two empirical hypotheses (tested on the
PoC). Complete proofs and design rationale appear in the
supplementary material \cite{berna2026proofs}.

\subsection{Empirical Hypothesis 1: Saturation-Triggered Splitting}

\begin{hypothesis}[Saturation-Triggered Splitting]
Let $K(t) \in [0,1]^6$ be the 6D knowledge vector of a cell $c$.
Let $\omega(t)$ be the adaptive weight vector in the simplex.
Define $S(c,t) = \|K(c,t)\|_\omega$. Under L-smoothness,
$\mu$-strong convexity, and sub-Gaussian noise assumptions,
there exists $S^* \in (0,1)$ such that:
\begin{itemize}
    \item[(i)] If $S < S^*$, continued training weakly decreases $L$.
    \item[(ii)] If $S \geq S^*$ for $T_{\text{cons}} \geq 3$ steps,
    splitting $c$ weakly decreases global loss.
    \item[(iii)] $K^*$ is weighted-isotropic:
    $\omega_i K^*_i = \omega_j K^*_j$ for all $i,j$.
\end{itemize}
\end{hypothesis}

\textbf{Constant:} $S^* = 0.85$ (empirically tuned).

\subsection{Design Invariant 1: Transactional Incorporation}

\begin{invariant}[Transactional Incorporation]
Let $B$ be a base model with $K_{6D}(B,t)$. Let $s_i$ be a
specialist returning answer $a$ with confidence $c_i \geq
\tau_{\text{conf}}$. Under the verification gate (logical +
consistency + 6D checks), incorporating $(r,a)$ into $B$:
\begin{itemize}
    \item[(i)] does not decrease $K_{6D}(B)$ by more than
    $\epsilon_{\text{neg}} = 10^{-6}$;
    \item[(ii)] strictly increases $K_{6D}(B)$ along dominant
    dimension $i^*(r)$ if $a$ fills a gap;
    \item[(iii)] leaves $K_{6D}(s_i)$ unchanged.
\end{itemize}
\end{invariant}

\subsection{Design Invariant 2: Protected Retention}

\begin{invariant}[Protected Retention]
Let $\theta_{\text{protected}}$ be the set of frozen cell
parameters that contributed to tasks $\{T_1, \ldots, T_k\}$.
Under cell isolation, their parameters satisfy:
\[
\|\theta_{\text{protected}}^{t+1} - \theta_{\text{protected}}^{t}\| = 0
\]
for all $t \geq t_{\text{freeze}}$.

The invariant is enforced by setting
\texttt{requires\_grad=False} on protected cells. It does not
by itself imply that the federation as a whole retains all
knowledge: that is tested separately by Hypothesis 2.
\end{invariant}

\subsection{Empirical Hypothesis 2: Bounded Forgetting}

\begin{hypothesis}[Bounded Forgetting]
Let $\mathcal{T} = \{T_1,\ldots,T_M\}$ be a fixed task set.
Define $F_j(t) = \max_{s \leq t} P_j(s) - P_j(t)$. Under cell
isolation, transactional incorporation, persistent registry log,
and correct thresholds, for all $j$ and $t$:
\[
F_j(t) \leq \epsilon_{\text{neg}} = 10^{-6}.
\]
This is an empirical claim, tested by the continual-learning
benchmark described in \texttt{experiments/cl\_bench/}.
\end{hypothesis}

\subsection{Mathematical Theorem 1: Balanced Growth Equilibrium}

\begin{theorem}[Balanced Growth Equilibrium]
Let $g = (\text{parent}, d_1, d_2)$ be a split. Define
$V(g) = \text{benefit}(g) - \text{cost}(g)$. Under necessity
($V > 0$), capacity ($\sum \text{footprint} \leq C$), and
diversity ($\text{div}(d_1,d_2) \geq \tau_{\text{div}}$)
constraints, the federation converges to a stable cell count
$N^*$ satisfying all three constraints.
\end{theorem}

\textbf{Constant:} $\tau_{\text{div}} = 0.3$.

\subsection{Mathematical Theorem 2: Plexus Connectivity Convergence}

\begin{theorem}[Plexus Connectivity Convergence]
For each edge $e$, $W_e(t+1) = W_e(t) + \eta_e (A_e(t) -
\lambda_e W_e(t))$. Under stationary $A_e(t)$ and
$0 < \eta_e \lambda_e < 2$, $W$ converges exponentially to
$W^*_e = A^*_e / \lambda_e$.
\end{theorem}

\textbf{Constants:} $\eta_e = 0.01$, $\lambda_e = 0.001$,
$\rho < 1$.

